{
  "name": "reachinbox-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend service for ReachInbox Email Scheduler",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "cross-env USE_MOCK_REDIS=true DATABASE_URL=file:./dev.db tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc && prisma generate --schema=prisma/schema.prisma",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:push:local": "cross-env DATABASE_URL=file:./dev.db prisma db push --schema=prisma/schema.sqlite.prisma",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.21.2",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^9.14.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "redis-memory-server": "^0.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8.2.8",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^6.4.16",
    "ioredis-mock": "^8.13.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
